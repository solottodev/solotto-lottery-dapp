# ===============================================
# Supabase Environment Configuration
# Copy this file to .env.supabase and fill in your values
# DO NOT COMMIT .env.supabase to version control
# ===============================================

# -----------------------------------------------
# Database Connection - Supabase
# -----------------------------------------------

# Get these values from: Supabase Dashboard → Project Settings → Database

# APPLICATION DATABASE (Read/Write via PgBouncer pooler)
# Use port 6543 for pooled connections (recommended for application)
# Format: postgresql://solotto_app:[password]@db.[project-ref].supabase.co:6543/postgres?pgbouncer=true&sslmode=require
DATABASE_URL="postgresql://solotto_app:YOUR_SOLOTTO_APP_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:6543/postgres?pgbouncer=true&sslmode=require"

# READ-ONLY DATABASE (For public GET endpoints)
# Format: postgresql://solotto_ro:[password]@db.[project-ref].supabase.co:6543/postgres?pgbouncer=true&sslmode=require
DATABASE_URL_RO="postgresql://solotto_ro:YOUR_SOLOTTO_RO_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:6543/postgres?pgbouncer=true&sslmode=require"

# DIRECT CONNECTION (For Prisma migrations only - no pooler)
# Use port 5432 for direct connection
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
DATABASE_URL_DIRECT="postgresql://postgres:YOUR_POSTGRES_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# -----------------------------------------------
# How to find your connection details:
# -----------------------------------------------
# 1. Go to https://app.supabase.com
# 2. Select your project
# 3. Go to Project Settings (gear icon) → Database
# 4. Scroll to "Connection string" section
# 5. Your project-ref is shown in the Host field: db.YOUR_PROJECT_REF.supabase.co
# 6. Copy the password you set during project creation

# -----------------------------------------------
# JWT Secret
# -----------------------------------------------
# Generate a strong random secret for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="changeme_generate_64_char_random_string"

# -----------------------------------------------
# Server Configuration
# -----------------------------------------------
PORT=4000
NODE_ENV="development"

# -----------------------------------------------
# Solana Configuration (Keep as devnet for testing)
# -----------------------------------------------
SOLANA_NETWORK="devnet"
ALCHEMY_API_KEY="OdXuOSa1pQHZbiyFRjxF_"
ALCHEMY_RPC_URL="https://solana-devnet.g.alchemy.com/v2/OdXuOSa1pQHZbiyFRjxF_"
SOLANA_RPC_FALLBACK="https://api.devnet.solana.com"

# -----------------------------------------------
# Token Configuration (Devnet)
# -----------------------------------------------
# For devnet testing, you can use USDC-Dev to test Jupiter swaps
# USDC-Dev (has Jupiter liquidity): 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Your LOTTO token (use on mainnet): HJSnJaQv3u4ZyvPXiQPTyBsYJpggWsZvVH8yedjBpump
LOTTO_MINT_ADDRESS="4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU"
LOTTO_DECIMALS=6

# -----------------------------------------------
# Jupiter API (optional override)
# -----------------------------------------------
# Override Jupiter base URL if needed (e.g., corporate proxy/DNS issues)
# Default is https://quote-api.jup.ag
# JUPITER_API_BASE_URL="https://quote-api.jup.ag"

# -----------------------------------------------
# Operator Wallet (Devnet for testing)
# -----------------------------------------------
# Option 1: Base58 encoded private key
OPERATOR_WALLET_PRIVATE_KEY="your_base58_encoded_devnet_private_key"
# Option 2: JSON array format (alternative)
# OPERATOR_WALLET_JSON="[1,2,3,...]"

# -----------------------------------------------
# Security - Hardcoded Blacklist
# -----------------------------------------------
# These wallets are permanently blacklisted from all lottery rounds
# Format: JSON array of Solana wallet addresses
HARD_BLACKLIST='["11111111111111111111111111111111","2CqSCmGSa3V7mdbHSFftSVJJ9qpLyPK5TSSNSRCQWJte"]'

# -----------------------------------------------
# IMPORTANT NOTES:
# -----------------------------------------------
# 1. For migrations, temporarily set DATABASE_URL to DATABASE_URL_DIRECT
#    Example: export DATABASE_URL=$DATABASE_URL_DIRECT && npx prisma migrate deploy
#
# 2. For running the application, use the pooled DATABASE_URL (port 6543)
#
# 3. Store production passwords in a secrets manager:
#    - AWS Secrets Manager
#    - Doppler
#    - HashiCorp Vault
#    - 1Password Secrets Automation
#
# 4. Generate strong passwords (32+ characters):
#    - Use a password manager
#    - Include uppercase, lowercase, numbers, special chars
#    - Example: openssl rand -base64 32
#
# 5. Never commit .env.supabase to Git:
#    - It's already in .gitignore
#    - Double check: git status
#
# 6. Rotate passwords quarterly for security
